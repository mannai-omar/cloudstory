# Copy to .env for docker compose. Never commit .env.
DB_PASSWORD=cloudstory
# Any long random string; CI will send it to record deployments. Leave empty to disable.
DEPLOY_EVENT_TOKEN=
# e.g. http://host.docker.internal:9090 if you run Prometheus locally. Leave empty = "not connected".
PROMETHEUS_URL=
GITHUB_URL=https://github.com/your-username/cloudstory
APP_VERSION=dev
GIT_COMMIT=unknown
